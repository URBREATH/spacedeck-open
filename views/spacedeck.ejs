<!doctype html>
<html class="no-js">
  <head>
    <meta charset="utf-8">
    <title>Spacedeck Open</title>
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, minimum-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link href="/images/favicon.png" rel="icon" type="image/x-icon" />
    <link rel="stylesheet" href="/stylesheets/style.css">
    <script>if (typeof module === 'object') {window.module = module; module = undefined;}</script>
    <% if (!user) { %>
    <script>
      (function () {
        var isEmbedded = window.self !== window.top;

        var KEYCLOAK_URL = '/keycloak';
        var allowedOrigins = <%- (config && config.keycloak && Array.isArray(config.keycloak.allowed_origins)) ? JSON.stringify(config.keycloak.allowed_origins) : "[]" %>;
        var timeoutMs = <%- (config && config.keycloak && config.keycloak.post_message_timeout_ms) ? Number(config.keycloak.post_message_timeout_ms) : 5000 %>;
        window.__spacedeckAllowedOrigins = allowedOrigins;
        console.log('Embedded login allowed origins:', allowedOrigins);
        var postLoginTimeout = timeoutMs + 5000;

        window.__spacedeckEmbeddedLoginPending = true;
        window.__spacedeckEmbeddedAuthenticated = false;
        window.__spacedeckEmbeddedLoginQueue = window.__spacedeckEmbeddedLoginQueue || [];

        var settled = false;
        var handshakeStarted = false;
        var handshakeTimer = null;
        var listenerRegistered = false;
        var currentUser = null;
        var currentUserEmail = null;

        function setCurrentUser(user) {
          if (user && typeof user === 'object') {
            currentUser = user;
            currentUserEmail = (user.email && typeof user.email === 'string') ? user.email.toLowerCase() : null;
          } else {
            currentUser = null;
            currentUserEmail = null;
          }

          window.__spacedeckCurrentUser = currentUser;
          window.__spacedeckCurrentUserEmail = currentUserEmail;
        }

        setCurrentUser(null);

        function flushQueue() {
          var queue = window.__spacedeckEmbeddedLoginQueue;
          if (!queue || !queue.length) return;
          while (queue.length) {
            var fn = queue.shift();
            try { fn(); } catch (err) {
              console.error('Error executing deferred load_user callback:', err);
            }
          }
        }

        function markSettled() {
          window.__spacedeckEmbeddedLoginPending = false;
          flushQueue();
        }

        function originAllowed(origin) {
          if (!origin) return false;
          if (!allowedOrigins || allowedOrigins.length === 0) return true;
          return allowedOrigins.indexOf(origin) !== -1;
        }

        function cleanupListeners() {
          if (handshakeTimer) {
            window.clearTimeout(handshakeTimer);
            handshakeTimer = null;
          }
        }

        function persistToken(token) {
          try {
            window.api_token = token;
            if (typeof api_token !== 'undefined') {
              api_token = token;
            }
          } catch (err) {
            console.warn('Unable to expose session token to frontend', err);
          }

          try {
            if (window.sessionStorage) {
              window.sessionStorage.setItem('sd_session_token', token);
            }
            if (window.localStorage) {
              window.localStorage.setItem('sd_session_token', token);
            }
          } catch (storageErr) {
            console.warn('Unable to persist embedded session token', storageErr);
          }

          try {
            document.cookie = 'sdsession=' + token + '; Path=/; SameSite=None; Secure; Domain=' + window.location.hostname;
          } catch (cookieErr) {
            console.warn('Unable to set fallback session cookie', cookieErr);
          }
        }

        function clearPersistedToken() {
          try {
            if (window.sessionStorage) { window.sessionStorage.removeItem('sd_session_token'); }
            if (window.localStorage) { window.localStorage.removeItem('sd_session_token'); }
          } catch (err) {
            console.warn('Embedded login: unable to clear cached token', err);
          }
          try {
            document.cookie = 'sdsession=; Path=/; Max-Age=0; SameSite=None; Secure; Domain=' + window.location.hostname;
          } catch (cookieErr) {
            console.warn('Embedded login: unable to clear cookie', cookieErr);
          }
          window.api_token = null;
          if (typeof api_token !== 'undefined') { api_token = null; }
          window.__spacedeckEmbeddedAuthenticated = false;
          setCurrentUser(null);
        }

        function readPersistedToken() {
          if (window.api_token) {
            return window.api_token;
          }

          try {
            if (window.sessionStorage) {
              var sessionToken = window.sessionStorage.getItem('sd_session_token');
              if (sessionToken) return sessionToken;
            }
            if (window.localStorage) {
              var localToken = window.localStorage.getItem('sd_session_token');
              if (localToken) return localToken;
            }
          } catch (storageErr) {
            console.warn('Embedded login: unable to read cached token', storageErr);
          }

          try {
            var cookieMatch = document.cookie.match(/(?:^|; )sdsession=([^;]+)/);
            if (cookieMatch && cookieMatch[1]) {
              return decodeURIComponent(cookieMatch[1]);
            }
          } catch (cookieErr) {
            console.warn('Embedded login: unable to read session cookie', cookieErr);
          }

          return null;
        }

        function completeLogin(payload) {
          if (settled) return;
          settled = true;
          cleanupListeners();

          if (payload && payload.session && payload.session.token) {
            persistToken(payload.session.token);
          }

          if (payload && payload.user) {
            setCurrentUser(payload.user);
          }

          window.__spacedeckEmbeddedAuthenticated = true;
          markSettled();

          if (window.location.pathname !== '/spaces') {
            window.location.replace('/spaces');
          }
        }

        function fallback(reason) {
          if (settled) return;
          settled = true;
          markSettled();
          cleanupListeners();
          clearPersistedToken();
          if (reason) console.warn('Embedded login fallback:', reason);
          window.location.replace(KEYCLOAK_URL);
        }

        function normalizeToken(data) {
          if (!data || typeof data !== 'object') return null;
          return data.accessToken || data.access_token || data.nextToken || null;
        }

        function decodeJwtPayload(token) {
          if (!token || typeof token !== 'string' || token.indexOf('.') === -1) return null;
          try {
            var base64 = token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');
            var padded = base64 + '='.repeat((4 - (base64.length % 4 || 4)) % 4);
            var json = window.atob(padded);
            return JSON.parse(json);
          } catch (err) {
            return null;
          }
        }

        function resolveIncomingEmail(data, token) {
          if (!data || typeof data !== 'object') return null;
          if (typeof data.email === 'string') return data.email.toLowerCase();
          if (data.profile && typeof data.profile.email === 'string') return data.profile.email.toLowerCase();

          if (token) {
            var claims = decodeJwtPayload(token);
            if (claims) {
              if (claims.email && typeof claims.email === 'string') return claims.email.toLowerCase();
              if (claims.preferred_username && typeof claims.preferred_username === 'string') return claims.preferred_username.toLowerCase();
            }
          }
          return null;
        }

        function handleMessage(event) {
          var data = event.data;
          if (!data || typeof data !== 'object') return;
          if (!originAllowed(event.origin)) {
            console.warn('Blocked postMessage from unexpected origin:', event.origin);
            return;
          }

          var isForceLogout = data.type === 'spacedeck-force-logout';
          var isEmbedded = data.embedded === true || data.type === 'spacedeck-embedded-auth' || data.type === 'spacedeck-token';
          if (!isEmbedded && !isForceLogout) return;

          var accessToken = normalizeToken(data);
          if (!accessToken && !isForceLogout) {
            console.warn('postMessage payload missing access token');
            return;
          }

          if (handshakeTimer) {
            window.clearTimeout(handshakeTimer);
            handshakeTimer = window.setTimeout(function () {
              fallback('token exchange timeout');
            }, postLoginTimeout);
          }

          var incomingEmail = resolveIncomingEmail(data, accessToken);
          settled = false;
          var shouldLogout = isForceLogout || (currentUserEmail && incomingEmail && incomingEmail !== currentUserEmail);

          function performTokenExchange(tokenOverride) {
            var tokenToUse = tokenOverride || accessToken;
            if (!tokenToUse) {
              console.warn('Embedded login: missing access token for exchange');
              fallback('missing_access_token');
              return;
            }
            console.log('Embedded login: exchanging token');
            fetch('/api/sessions/keycloak/token', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              credentials: 'include',
              body: JSON.stringify({
                accessToken: tokenToUse,
                refreshToken: data.refreshToken || data.refresh_token,
                language: data.language || data.locale,
                email: data.email,
                name: data.name || data.fullName || data.preferred_username,
                profile: data.profile || null
              })
            })
              .then(function (response) {
                console.log('Embedded login: exchange status', response.status);
                if (!response.ok) throw new Error('exchange_failed_' + response.status);
                return response.json();
              })
              .then(function (payload) {
                console.log('Embedded login: exchange succeeded');
                completeLogin(payload);
              })
              .catch(function (err) {
                console.error('Embedded login error', err);
                clearPersistedToken();
                fallback('token exchange failed');
              });
          }

          if (shouldLogout) {
            console.log('Embedded login: initiating logout before token exchange', isForceLogout ? '(force logout)' : '(user changed)');
            window.__spacedeckEmbeddedAuthenticated = false;
            window.__spacedeckEmbeddedLoginPending = true;
            var previousToken = readPersistedToken();
            var logoutHeaders = {};
            if (previousToken) {
              logoutHeaders['X-Spacedeck-Auth'] = previousToken;
            }

            fetch('/api/sessions/current', {
              method: 'DELETE',
              credentials: 'include',
              headers: logoutHeaders
            }).catch(function (err) {
              console.warn('Embedded login: failed to delete session before switch', err);
            }).finally(function () {
              clearPersistedToken();
              setCurrentUser(null);
              settled = false;
              if (accessToken) {
                performTokenExchange(accessToken);
              } else if (isForceLogout) {
                handshakeStarted = false;
                // No next token provided → restart handshake to request a new one
                startHandshake();
              }
            });
          } else {
            performTokenExchange();
          }
        }

        function startHandshake() {
          if (handshakeStarted || settled) return;
          handshakeStarted = true;

          if (!listenerRegistered) {
            window.addEventListener('message', handleMessage);
            listenerRegistered = true;
          }
          handshakeTimer = window.setTimeout(function () {
            fallback('timeout waiting token');
          }, Math.max(timeoutMs, 3000));

          try {
            var handshakeMessage = { type: 'spacedeck-auth-request' };
            if (allowedOrigins && allowedOrigins.length) {
              allowedOrigins.forEach(function (origin) {
                window.parent.postMessage(handshakeMessage, origin);
              });
            } else {
              window.parent.postMessage(handshakeMessage, '*');
            }
          } catch (err) {
            console.warn('Unable to notify parent frame for embedded auth:', err);
          }
        }

        var storedSessionToken = null;
        try {
          if (window.sessionStorage) {
            storedSessionToken = window.sessionStorage.getItem('sd_session_token');
          }
          if (!storedSessionToken && window.localStorage) {
            storedSessionToken = window.localStorage.getItem('sd_session_token');
          }
        } catch (storageErr) {
          console.warn('Unable to read embedded session token', storageErr);
        }
        if (storedSessionToken) {
          persistToken(storedSessionToken);
        }

        console.log('Embedded login: probing current user');
        var probeHeaders = { 'Accept': 'application/json' };
        if (window.api_token) {
          probeHeaders['X-Spacedeck-Auth'] = window.api_token;
        }

        fetch('/api/users/current', {
          method: 'GET',
          credentials: 'include',
          headers: probeHeaders
        })
          .then(function (response) {
            console.log('Embedded login: probe status', response.status);
            if (!response.ok) throw new Error('not_authenticated');
            return response.json();
          })
          .then(function (user) {
            console.log('Embedded login: probe succeeded');
            if (user) setCurrentUser(user);
            completeLogin({ user: user });
          })
          .catch(function (err) {
            console.warn('Embedded login: probe failed', err);
            clearPersistedToken();
            if (isEmbedded) {
              startHandshake();
            } else {
              fallback('probe failed');
            }
          });
      })();
    </script>
    <% } %>
    <script>
      var ENV = {
        name: 'development',
        webHost: location.host,
        webEndpoint: location.origin,
        apiEndpoint: location.origin,
        websocketsEndpoint: location.origin.replace("https:","wss:").replace("http:","ws:"),
        options: <%- config && config.spacedeck ? JSON.stringify(config.spacedeck) : "{}" %>
      };
    </script>

    <script src="/javascripts/jquery-2.1.4.min.js"></script>
    <script src="/javascripts/i18next-1.11.2.js"></script>
    <script src="/javascripts/clipboard.js"></script>

    <script src="/javascripts/lodash.compat.js"></script>
    <script src="/javascripts/fastclick.js"></script>
    <script src="/javascripts/vue.js"></script>
    <script src="/javascripts/moment.js"></script>
    <script src="/javascripts/medium.patched.js"></script>
    <script src="/javascripts/route-recognizer.js"></script>

    <script src="/javascripts/backend.js"></script>
    <script src="/javascripts/link_parser.js"></script>
    <script src="/javascripts/vector-render.js"></script>
    <script src="/javascripts/mousetrap.js"></script>
    <script src="/javascripts/smoke.js"></script>
    <script src="/javascripts/helper.js"></script>
    <script src="/javascripts/packer.growing.js"></script>

    <script src="/javascripts/spacedeck_routes.js"></script>
    <script src="/javascripts/spacedeck_formatting.js"></script>
    <script src="/javascripts/spacedeck_sections.js"></script>
    <script src="/javascripts/spacedeck_spaces.js"></script>
    <script src="/javascripts/spacedeck_teams.js"></script>
    <script src="/javascripts/spacedeck_board_artifacts.js"></script>
    <script src="/javascripts/spacedeck_users.js"></script>
    <script src="/javascripts/spacedeck_account.js"></script>
    <script src="/javascripts/spacedeck_modals.js"></script>
    <script src="/javascripts/spacedeck_avatars.js"></script>
    <script src="/javascripts/spacedeck_websockets.js"></script>

    <script src="/javascripts/spacedeck_whiteboard.js"></script>
    <script src="/javascripts/spacedeck_directives.js"></script>
    <script src="/javascripts/spacedeck_vue.js"></script>

    <script>if (window.module) module = window.module;</script>
  </head>

  <body id="main" v-bind:class="{'present-mode':present_mode,'modal-open':active_modal}" v-on:click="handle_body_click($event)">
    <%- include("./partials/login.html") %>
    <%- include("./partials/space.html") %>
    <%- include("./partials/folders.html") %>
    <%- include("./partials/team.html") %>
    <%- include("./partials/account.html") %>
    <%- include("./partials/meta.html") %>
    <%- include("./partials/meta-folder.html") %>
    <%- include("./partials/modal/access.html") %>
    <%- include("./partials/modal/folder-settings.html") %>
  </body>

  <script type="text/javascript">
    window.locales = {};
    window.locales.de = {};
    window.locales.en = {};
    window.locales.es = {};
    window.locales.fr = {};
    window.locales.hu = {};
    window.locales.oc = {};
    window.locales.de.translation = <%- include("./../locales/de.js") %>;
    window.locales.en.translation = <%- include("./../locales/en.js") %>;
    window.locales.es.translation = <%- include("./../locales/es.js") %>;
    window.locales.fr.translation = <%- include("./../locales/fr.js") %>;
    window.locales.hu.translation = <%- include("./../locales/hu.js") %>;
    window.locales.oc.translation = <%- include("./../locales/oc.js") %>;
  </script>
</html>
